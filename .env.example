# Lead Qualification Agent — environment variables
# Copy this file to .env and fill in your real keys. .env is git-ignored.
# Keys here load automatically when the app starts; anything you paste
# into the app UI at runtime overrides these.

# Google Places API (New) — preferred backend
# From https://console.cloud.google.com/ (enable "Places API (New)")
GOOGLE_PLACES_API_KEY=

# SerpAPI — fallback backend (free tier: 100 searches/month)
# From https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
